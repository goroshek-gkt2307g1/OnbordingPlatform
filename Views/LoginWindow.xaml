<Window x:Class="OnbordingPlatform.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen" FocusManager.FocusedElement="{Binding ElementName=UsernameTextBox}">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Авторизация" 
                      FontSize="48" 
                      FontWeight="Bold"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"/>

            <TextBlock Text="Username"
                       FontSize="20" 
                        FontWeight="Bold"
                        HorizontalAlignment="Left"
                        Margin="200,0,0,5"/>

            <TextBox x:Name="UsernameTextBox"
                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                    Height="30" Margin="200,0,200,10"/>

            <TextBlock Text="Password"
                     FontSize="20" 
                    FontWeight="Bold"
                    HorizontalAlignment="Left"
                    Margin="200,0,0,5"/>

            <PasswordBox x:Name="PasswordBox" 
                        PasswordChanged="PasswordBox_PasswordChanged"
                        Height="30" Margin="200,0,200,20"/>

            <WrapPanel>
                <Button IsDefault="True" Content="Войти" 
                    Command="{Binding LoginCommand}"
                    Height="35" Width="640" Background="#C8FBFF" Foreground="Black"
                        FontWeight="Bold" FontSize="15"
                    Margin="200,0,96,0"/>
            </WrapPanel>



            <TextBlock Text="{Binding ErrorMessage}"
                      Foreground="Red" 
                      Margin="200,10,200,0"
                      TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
