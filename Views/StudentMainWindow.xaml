<Window x:Class="OnbordingPlatform.Views.StudentMainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:OnbordingPlatform.Converters"
	Title="Панель ученика"
	Height="720"
	Width="1200"
	WindowStartupLocation="CenterScreen"
	Background="White">
	<!-- РЕСУРСЫ ОКНА -->
	<Window.Resources>
		<!-- конвертер статуса в цвет-->
		<local:StatusToColorConverter x:Key="StatusToColorConverter"/>
		<!-- конвертер bool в Visibility-->
		<BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
		<!-- конвертер для строки в видимость-->
		<local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
		<!-- конвертер для архивных курсов-->
		<local:ArchiveCourseVisibilityConverter x:Key="ArchiveCourseVisibilityConverter"/>
	</Window.Resources>
	<!-- ОСНОВНОЙ КОНТЕЙНЕР -->
	<Grid>
		<!-- КОЛОНКИ ГРИДА-->
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="200"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<!-- БОКОВОЕ МЕНЮ (ЛЕВАЯ КОЛОНКА) -->
		<Border Grid.Column="0"
				Background="#F5F5F5"
				BorderBrush="LightGray"
				BorderThickness="0,0,1,0">
			<StackPanel>
				<!-- заголовок меню-->
				<Border Height="60"
						Background="White"
						BorderBrush="LightGray"
						BorderThickness="0,0,0,1">
					<TextBlock Text="Меню"
							FontSize="16"
							FontWeight="Bold"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"/>
				</Border>
				<!-- РАЗДЕЛЫ МЕНЮ -->
				<StackPanel Margin="10" Orientation="Vertical">
					<!-- кнопка моих курсов-->
					<Button Content="Мои курсы"
							Command="{Binding ShowCoursesCommand}"
							Height="40"
							Background="{Binding CoursesButtonColor}"
							FontWeight="Bold"
							Margin="0,10,0,5"/>
					<!-- кнопка выхода-->
					<Button Content="Выйти"
							Command="{Binding LogoutCommand}"
							Height="40"
							Background="LightCoral"
							Margin="0,5,0,0"/>
				</StackPanel>
			</StackPanel>
		</Border>
		<!-- ОСНОВНОЙ КОНТЕНТ (ПРАВАЯ КОЛОНКА) -->
		<Grid Grid.Column="1">
			<!-- СПИСОК КУРСОВ -->
			<StackPanel Visibility="{Binding ShowCoursesVisibility}" Margin="20">
				<!-- заголовок и логотип-->
				<Grid Margin="0,0,0,30">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<!-- логотип-->
					<Border Grid.Column="0"
							Width="40" Height="40"
							Background="#FFADE6C5"
							CornerRadius="5"
							Margin="0,0,20,0">
						<TextBlock Text="GK"
								   FontSize="20"
								   FontWeight="Bold"
								   Foreground="White"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"/>
					</Border>
					<!-- название раздела-->
					<TextBlock Text="Мои курсы"
							   Grid.Column="1"
							   FontSize="28"
							   FontWeight="Bold"
							   VerticalAlignment="Center"/>
				</Grid>
				<!-- СТАТИСТИКА -->
				<Grid Margin="0,0,0,30">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<!-- всего заданий-->
					<Border Grid.Column="0"
							BorderThickness="1"
							BorderBrush="LightGray"
							Background="WhiteSmoke"
							CornerRadius="5"
							Padding="20,15"
							Margin="0,0,10,0">
						<StackPanel>
							<TextBlock Text="{Binding TotalTasksText}"
									   FontSize="18"
									   FontWeight="Bold"
									   Margin="0,0,0,5"/>
							<TextBlock Text="Всего заданий"
									   FontSize="12"
									   Foreground="Gray"/>
						</StackPanel>
					</Border>
					<!-- выполнено-->
					<Border Grid.Column="1"
							BorderThickness="1"
							BorderBrush="LightGray"
							Background="WhiteSmoke"
							CornerRadius="5"
							Padding="20,15"
							Margin="5,0,5,0">
						<StackPanel>
							<TextBlock Text="{Binding CompletedTasksText}"
									   FontSize="18"
									   FontWeight="Bold"
									   Margin="0,0,0,5"/>
							<TextBlock Text="Выполнено"
									   FontSize="12"
									   Foreground="Gray"/>
						</StackPanel>
					</Border>
					<!-- ожидает проверки-->
					<Border Grid.Column="2"
							BorderThickness="1"
							BorderBrush="LightGray"
							Background="WhiteSmoke"
							CornerRadius="5"
							Padding="20,15"
							Margin="10,0,0,0">
						<StackPanel>
							<TextBlock Text="{Binding PendingTasksText}"
									   FontSize="18"
									   FontWeight="Bold"
									   Margin="0,0,0,5"/>
							<TextBlock Text="Ожидает проверки"
									   FontSize="12"
									   Foreground="Gray"/>
						</StackPanel>
					</Border>
				</Grid>
				<!-- СПИСОК АКТИВНЫХ КУРСОВ -->
				<TextBlock Text="Активные курсы"
						   FontSize="16"
						   FontWeight="Bold"
						   Margin="0,0,0,10"/>
				<!-- список курсов-->
				<ItemsControl ItemsSource="{Binding StudentCourses}"
							  Margin="0,0,0,20">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border BorderBrush="LightGray"
									BorderThickness="1"
									CornerRadius="5"
									Margin="0,0,0,10"
									Padding="20">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<!-- информация о курсе-->
									<StackPanel Grid.Column="0">
										<TextBlock Text="{Binding CourseTitle}"
												   FontSize="18"
												   FontWeight="Bold"
												   Margin="0,0,0,5"/>
										<TextBlock Text="{Binding CourseDescription}"
												   FontSize="14"
												   Foreground="Gray"
												   TextWrapping="Wrap"
												   MaxHeight="50"
												   TextTrimming="CharacterEllipsis"/>
										<!-- теги курса-->
										<WrapPanel Margin="0,10,0,0">
											<Border Background="#E8F4FD"
													CornerRadius="3"
													Padding="8,4"
													Margin="0,0,10,0">
												<TextBlock Text="{Binding MentorIdFkNavigation.FullName}"
														   FontSize="12"/>
											</Border>
											<Border Background="#E8F4FD"
													CornerRadius="3"
													Padding="8,4"
													Margin="0,0,10,0">
												<TextBlock Text="{Binding TasksCount, StringFormat='Заданий: {0}'}"
														   FontSize="12"/>
											</Border>
											<Border Background="{Binding CourseStatusIdFkNavigation.StatusName,
														Converter={StaticResource StatusToColorConverter}}"
													CornerRadius="3"
													Padding="8,4">
												<TextBlock Text="{Binding CourseStatusIdFkNavigation.StatusName}"
														   Foreground="White"
														   FontWeight="Bold"
														   FontSize="12"/>
											</Border>
										</WrapPanel>
									</StackPanel>
									<!-- кнопка открытия-->
									<Button Grid.Column="1"
											Content="Открыть"
											Command="{Binding DataContext.OpenCourseDetailsCommand,
													 RelativeSource={RelativeSource AncestorType=Window}}"
											CommandParameter="{Binding}"
											Width="100" Height="35"
											Background="#4285F4"
											Foreground="White"
											FontWeight="Bold"
											VerticalAlignment="Center"/>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
			<!-- ДЕТАЛИ КУРСА -->
			<Grid Grid.Column="1"
				  Visibility="{Binding ShowCourseDetailsVisibility}"
				  Background="White"
				  Panel.ZIndex="500"
				  Margin="20">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<!-- заголовок и кнопка назад-->
					<Grid Grid.Row="0" Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<!-- кнопка назад-->
						<Button Grid.Column="0"
								Content="← Назад к курсам"
								Command="{Binding BackToCoursesCommand}"
								Width="150" Height="35"
								Background="White"
								BorderBrush="LightGray"
								FontWeight="SemiBold"
								Margin="0,0,20,0"/>
						<!-- название курса-->
						<TextBlock Grid.Column="1"
								   Text="{Binding CurrentCourseDetails.CourseTitle}"
								   FontSize="28"
								   FontWeight="Bold"
								   VerticalAlignment="Center"/>
						<!-- статус курса-->
						<Border Grid.Column="2"
								Background="{Binding CurrentCourseDetails.CourseStatusIdFkNavigation.StatusName,
											Converter={StaticResource StatusToColorConverter}}"
								CornerRadius="5"
								Padding="15,8"
								VerticalAlignment="Center">
							<TextBlock Text="{Binding CurrentCourseDetails.CourseStatusIdFkNavigation.StatusName}"
									   Foreground="White"
									   FontWeight="Bold"/>
						</Border>
					</Grid>
					<!-- ИНФОРМАЦИЯ О КУРСЕ -->
					<Border Grid.Row="1"
							BorderBrush="LightGray"
							BorderThickness="0,0,0,1"
							Margin="0,0,0,20"
							Padding="0,0,0,20">
						<StackPanel>
							<!-- описание курса-->
							<TextBlock Text="{Binding CurrentCourseDetails.CourseDescription}"
									   FontSize="14"
									   TextWrapping="Wrap"
									   Margin="0,0,0,15"/>
							<!-- статистика курса-->
							<WrapPanel>
								<!-- ментор-->
								<Border BorderBrush="LightGray"
										BorderThickness="1"
										CornerRadius="5"
										Padding="15,10"
										Margin="0,0,15,5">
									<StackPanel>
										<TextBlock Text="Ментор"
												   FontSize="11"
												   Foreground="Gray"
												   Margin="0,0,0,2"/>
										<TextBlock Text="{Binding CurrentCourseDetails.MentorIdFkNavigation.FullName}"
												   FontWeight="SemiBold"/>
									</StackPanel>
								</Border>
								<!-- дата создания-->
								<Border BorderBrush="LightGray"
										BorderThickness="1"
										CornerRadius="5"
										Padding="15,10"
										Margin="0,0,15,5">
									<StackPanel>
										<TextBlock Text="Дата создания"
												   FontSize="11"
												   Foreground="Gray"
												   Margin="0,0,0,2"/>
										<TextBlock Text="{Binding CurrentCourseDetails.CreationDate, StringFormat='dd.MM.yyyy'}"
												   FontWeight="SemiBold"/>
									</StackPanel>
								</Border>
								<!-- статистика курса-->
								<Border BorderBrush="LightGray"
										BorderThickness="1"
										CornerRadius="5"
										Padding="15,10"
										Margin="0,0,15,5">
									<StackPanel>
										<TextBlock Text="Всего заданий"
												   FontSize="11"
												   Foreground="Gray"
												   Margin="0,0,0,2"/>
										<TextBlock Text="{Binding TotalTasksText}"
												   FontSize="16"
												   FontWeight="Bold"/>
									</StackPanel>
								</Border>
								<Border BorderBrush="LightGray"
										BorderThickness="1"
										CornerRadius="5"
										Padding="15,10"
										Margin="0,0,15,5">
									<StackPanel>
										<TextBlock Text="Выполнено"
												   FontSize="11"
												   Foreground="Gray"
												   Margin="0,0,0,2"/>
										<TextBlock Text="{Binding CompletedTasksText}"
												   FontSize="16"
												   FontWeight="Bold"/>
									</StackPanel>
								</Border>
							</WrapPanel>
						</StackPanel>
					</Border>
					<!-- СПИСОК ЗАДАНИЙ КУРСА -->
					<Grid Grid.Row="2">
						<ScrollViewer VerticalScrollBarVisibility="Auto"
									Margin="0,0,0,20">
							<StackPanel>
								<TextBlock Text="Задания курса"
										   FontSize="18"
										   FontWeight="Bold"
										   Margin="0,0,0,15"/>
								<!-- список заданий-->
								<ItemsControl ItemsSource="{Binding CourseTasks}"
                          Margin="0,0,0,20">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border BorderBrush="LightGray"
													BorderThickness="1"
													CornerRadius="5"
													Margin="0,0,0,10"
													Padding="20">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>
													<!-- информация о задании-->
													<StackPanel Grid.Column="0">
														<TextBlock Text="{Binding Task.TaskTitle}"
																   FontSize="16"
																   FontWeight="Bold"
																   Margin="0,0,0,5"/>
														<TextBlock Text="{Binding Task.TaskDescription}"
																   FontSize="14"
																   Foreground="Gray"
																   TextWrapping="Wrap"
																   MaxHeight="50"
																   TextTrimming="CharacterEllipsis"
																   Margin="0,0,0,5"/>
														<!-- срок и статус задания-->
														<WrapPanel Margin="0,10,0,0">
															<Border Background="#E8F4FD"
																	CornerRadius="3"
																	Padding="8,4"
																	Margin="0,0,10,0">
																<TextBlock Text="{Binding Task.DueDate, StringFormat='Срок: {0:dd.MM.yyyy}'}"
                                                       FontSize="12"/>
															</Border>
															<Border Background="{Binding StatusDisplay,
																	Converter={StaticResource StatusToColorConverter}}"
																	CornerRadius="3"
																	Padding="8,4">
																<TextBlock Text="{Binding StatusDisplay}"
																		   Foreground="White"
																		   FontWeight="Bold"
																		   FontSize="12"/>
															</Border>
														</WrapPanel>
													</StackPanel>
													<!-- КНОПКИ ДЛЯ ОТПРАВКИ/ПЕРЕОТПРАВКИ -->
													<StackPanel Grid.Column="1"
																Orientation="Vertical"
																VerticalAlignment="Center">
														<!-- кнопка отправить ответ-->
														<Button Content="Отправить ответ"
																Command="{Binding DataContext.SubmitAnswerCommand,
																RelativeSource={RelativeSource AncestorType=Window}}"
																CommandParameter="{Binding}"
																Width="120" Height="30"
																Background="#4285F4"
																Foreground="White"
																FontWeight="Bold"
																Margin="0,0,0,5">
															<Button.Visibility>
																<MultiBinding Converter="{StaticResource ArchiveCourseVisibilityConverter}">
																	<Binding Path="CanSubmit"/>
																	<Binding Path="DataContext.CurrentCourseDetails.CourseStatusIdFkNavigation.StatusName"
																			 RelativeSource="{RelativeSource AncestorType=Window}"/>
																</MultiBinding>
															</Button.Visibility>
														</Button>
														<!-- кнопка переотправить-->
														<Button Content="Переотправить"
																Command="{Binding DataContext.SubmitAnswerCommand,
																		  RelativeSource={RelativeSource AncestorType=Window}}"
																CommandParameter="{Binding}"
																Width="120" Height="30"
																Background="#FBBC05"
																Foreground="White"
																FontWeight="Bold">
															<Button.Visibility>
																<MultiBinding Converter="{StaticResource ArchiveCourseVisibilityConverter}">
																	<Binding Path="CanResubmit"/>
																	<Binding Path="DataContext.CurrentCourseDetails.CourseStatusIdFkNavigation.StatusName"
																			 RelativeSource="{RelativeSource AncestorType=Window}"/>
																</MultiBinding>
															</Button.Visibility>
														</Button>
														<!-- сообщение для архивных курсов-->
														<TextBlock Text="Курс в архиве"
																   Foreground="Gray"
																   FontStyle="Italic"
																   VerticalAlignment="Center"
																   Visibility="{Binding DataContext.CurrentCourseDetails.CourseStatusIdFkNavigation.StatusName,
																			RelativeSource={RelativeSource AncestorType=Window},
																			Converter={StaticResource StringToVisibilityConverter},
																			ConverterParameter='Archive'}"/>
														<!-- если задание уже принято-->
														<TextBlock Text="✓ Задание принято"
																   Foreground="#34A853"
																   FontWeight="Bold"
																   VerticalAlignment="Center"
																   Visibility="{Binding Status,
																			  Converter={StaticResource StringToVisibilityConverter},
																			  ConverterParameter='Accepted'}"/>
														<TextBlock Text="✓ Принято"
																   Foreground="#34A853"
																   FontWeight="Bold"
																   VerticalAlignment="Center"
																   Visibility="{Binding Status,
																			  Converter={StaticResource StringToVisibilityConverter},
																			  ConverterParameter='Принято'}"/>
													</StackPanel>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Grid>
			</Grid>
		</Grid>
		<!-- МОДАЛКА ОТПРАВКИ ОТВЕТА -->
		<Grid Grid.ColumnSpan="2"
			  Visibility="{Binding ShowSubmitModalVisibility}"
			  Panel.ZIndex="1000"
			  Background="#80000000">
			<Border Width="400"
					Height="450"
					Background="White"
					CornerRadius="10"
					BorderBrush="LightGray"
					BorderThickness="1"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
				<Grid Margin="20">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<!-- заголовок модалки-->
					<Grid Grid.Row="0" Margin="0,0,0,20">
						<Grid.RowDefinitions>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<TextBlock Grid.Row="0"
								   Text="Отправка ответа на задание"
								   FontSize="18"
								   FontWeight="Bold"/>
						<TextBlock Grid.Row="1"
								   Text="{Binding SelectedTaskForAnswer.Task.TaskTitle}"
								   FontSize="14"
								   FontWeight="SemiBold"
								   Foreground="#4285F4"
								   VerticalAlignment="Center"/>
					</Grid>
					<!-- ПОЛЯ ФОРМЫ -->
					<StackPanel Grid.Row="1" Orientation="Vertical">
						<!-- текст ответа-->
						<StackPanel Margin="0,0,0,15">
							<TextBlock Text="Текст ответа:" FontWeight="SemiBold"/>
							<TextBox Height="200"
									 Padding="5"
									 TextWrapping="Wrap"
									 AcceptsReturn="True"
									 VerticalScrollBarVisibility="Auto"
									 Text="{Binding AnswerText, UpdateSourceTrigger=PropertyChanged}"/>
						</StackPanel>
						<!-- срок сдачи-->
						<StackPanel>
							<TextBlock Text="Срок сдачи задания:" FontWeight="SemiBold"/>
							<TextBlock Text="{Binding SelectedTaskForAnswer.Task.DueDate, StringFormat='dd.MM.yyyy'}"
									   FontSize="14"
									   FontWeight="SemiBold"
									   Margin="0,5,0,0"/>
						</StackPanel>
					</StackPanel>
					<!-- КНОПКИ -->
					<StackPanel Grid.Row="2"
								Orientation="Horizontal"
								HorizontalAlignment="Right"
								Margin="0,20,0,0">
						<!-- кнопка отмены-->
						<Button Content="Отменить"
								Width="120"
								Height="35"
								Command="{Binding CancelSubmitCommand}"
								Margin="0,0,10,0"/>
						<!-- кнопка отправки-->
						<Button Content="Отправить"
								Width="120"
								Height="35"
								Command="{Binding ConfirmSubmitCommand}"
								Background="#34A853"
								Foreground="White"
								FontWeight="Bold"/>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Window>