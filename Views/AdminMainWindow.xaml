<Window x:Class="OnbordingPlatform.Views.AdminMainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:OnbordingPlatform.Converters"
	Title="Панель администратора"
	Height="720"
	Width="1200"
	WindowStartupLocation="CenterScreen"
	Background="White">
	<!-- РЕСУРСЫ ОКНА-->
	<Window.Resources>
		<!-- конвертер статуса в цвет-->
		<local:StatusToColorConverter x:Key="StatusToColorConverter"/>
		<!-- конвертер bool в Visibility-->
		<BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
	</Window.Resources>
	<!-- ОСНОВНОЙ КОНТЕЙНЕР-->
	<Grid>
		<!-- КОЛОНКИ ГРИДА-->
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="200"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<!-- БОКОВОЕ МЕНЮ (ЛЕВАЯ КОЛОНКА)-->
		<Border Grid.Column="0"
				Background="#F5F5F5"
				BorderBrush="LightGray"
				BorderThickness="0,0,1,0">
			<StackPanel>
				<!-- заголовок меню-->
				<Border Height="60"
						Background="White"
						BorderBrush="LightGray"
						BorderThickness="0,0,0,1">
					<TextBlock Text="Меню"
							FontSize="16"
							FontWeight="Bold"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"/>
				</Border>
				<!-- разделы меню-->
				<StackPanel Margin="10" Orientation="Vertical">
					<!-- кнопка пользователей-->
					<Button Content="Пользователи"
							Command="{Binding ShowUsersCommand}"
							Height="40"
							Background="{Binding UsersButtonColor}"
							FontWeight="Bold"
							Margin="0,10,0,0"/>
					<!-- кнопка курсов-->
					<Button Content="Курсы"
							Command="{Binding ShowCoursesCommand}"
							Height="40"
							Background="{Binding CoursesButtonColor}"
							Margin="0,5,0,0"/>
					<!-- кнопка выхода-->
					<Button Content="Выйти"
							Command="{Binding LogoutCommand}"
							Height="40"
							Background="LightCoral"
							Margin="0,5,0,0"/>
				</StackPanel>
			</StackPanel>
		</Border>
		<!-- ОСНОВНОЙ КОНТЕНТ (ПРАВАЯ КОЛОНКА)-->
		<Grid Grid.Column="1">
			<!-- ЭКРАН ПОЛЬЗОВАТЕЛЕЙ-->
			<StackPanel Visibility="{Binding ShowUsersVisibility}" Margin="20">
				<!-- заголовок и логотип-->
				<Grid Margin="0,0,0,30">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<!-- логотип-->
					<Border Grid.Column="0"
							Width="40" Height="40"
							Background="#FFADE6C5"
							CornerRadius="5"
							Margin="0,0,20,0">
						<TextBlock Text="GK"
								   FontSize="20"
								   FontWeight="Bold"
								   Foreground="White"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"/>
					</Border>
					<!-- название раздела-->
					<TextBlock Text="Пользователи"
							   Grid.Column="1"
							   FontSize="28"
							   FontWeight="Bold"
							   VerticalAlignment="Center"/>
				</Grid>
				<!-- счетчик и кнопка добавления-->
				<Grid Margin="0,0,0,30">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<!-- счетчик пользователей-->
					<Border Grid.Column="0"
							BorderThickness="1"
							BorderBrush="LightGray"
							Background="WhiteSmoke"
							CornerRadius="5"
							Padding="20,15">
						<StackPanel>
							<TextBlock Text="{Binding UsersCountText}"
									   FontSize="18"
									   FontWeight="Bold"
									   Margin="0,0,0,5"/>
							<TextBlock Text="Количество всех пользователей в системе"
									   FontSize="12"
									   Foreground="Gray"/>
						</StackPanel>
					</Border>
					<!-- кнопка добавления пользователя-->
					<Button Grid.Column="1"
							Content="Добавить пользователя"
							Command="{Binding AddUserCommand}"
							Width="180" Height="40"
							Background="#C8FBFF"
							FontWeight="Bold"
							FontSize="14"
							Margin="20,0,0,0"/>
				</Grid>
				<!-- таблица пользователей-->
				<Grid>
					<DataGrid x:Name="UsersGrid"
								ItemsSource="{Binding Users}"
								AutoGenerateColumns="False"
								CanUserAddRows="False"
								IsReadOnly="True"
								HeadersVisibility="Column"
								BorderThickness="1"
								BorderBrush="LightGray">
						<DataGrid.Columns>
							<!-- столбец Username-->
							<DataGridTextColumn Header="Username"
												Binding="{Binding Username}"
												Width="100"/>
							<!-- столбец Password-->
							<DataGridTextColumn Header="Password"
												Binding="{Binding Password}"
												Width="100"/>
							<!-- столбец ФИО-->
							<DataGridTextColumn Header="ФИО"
												Binding="{Binding FullName}"
												Width="230"/>
							<!-- столбец Роль-->
							<DataGridTextColumn Header="Роль"
												Binding="{Binding RoleIdFkNavigation.RoleName}"
												Width="120"/>
							<!-- столбец Статус-->
							<DataGridTextColumn Header="Статус"
												Binding="{Binding AccountStatusFkNavigation.StatusName}"
												Width="100"/>
							<!-- столбец Дата создания-->
							<DataGridTextColumn Header="Дата создания"
												Binding="{Binding HireDate, StringFormat='dd.MM.yyyy'}"
												Width="120"/>
							<!-- столбец действий-->
							<DataGridTemplateColumn Header="Действия" Width="180">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<!-- кнопка редактирования-->
											<Button Content="Редактировать"
													Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
													CommandParameter="{Binding}"
													Margin="2"
													Padding="8,4"
													Background="#4285F4"
													Foreground="White"
													FontSize="12"/>
											<!-- кнопка удаления-->
											<Button Content="Удалить"
													Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
													CommandParameter="{Binding}"
													Margin="2"
													Padding="8,4"
													Background="#AC4242"
													Foreground="White"
													FontSize="12"/>
										</StackPanel>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</StackPanel>
			<!-- ЭКРАН КУРСОВ-->
			<StackPanel Visibility="{Binding ShowCoursesVisibility}" Margin="20">
				<!-- заголовок и логотип-->
				<Grid Margin="0,0,0,30">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<!-- логотип-->
					<Border Grid.Column="0"
							Width="40" Height="40"
							Background="#FFADE6C5"
							CornerRadius="5"
							Margin="0,0,20,0">
						<TextBlock Text="GK"
								   FontSize="20"
								   FontWeight="Bold"
								   Foreground="White"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"/>
					</Border>
					<!-- название раздела-->
					<TextBlock Text="Курсы"
							   Grid.Column="1"
							   FontSize="28"
							   FontWeight="Bold"
							   VerticalAlignment="Center"/>
				</Grid>
				<!-- счетчик и кнопка добавления-->
				<Grid Margin="0,0,0,30">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<!-- счетчик курсов-->
					<Border Grid.Column="0"
							BorderThickness="1"
							BorderBrush="LightGray"
							Background="WhiteSmoke"
							CornerRadius="5"
							Padding="20,15">
						<StackPanel>
							<TextBlock Text="{Binding CoursesCountText}"
								FontSize="18"
								FontWeight="Bold"
								Margin="0,0,0,5"/>
							<TextBlock Text="Количество всех курсов в системе"
								FontSize="12"
								Foreground="Gray"/>
						</StackPanel>
					</Border>
					<!-- кнопка добавления курса-->
					<Button Grid.Column="1"
							Content="Добавить курс"
							Command="{Binding AddCourseCommand}"
							Width="180" Height="40"
							Background="#C8FBFF"
							FontWeight="Bold"
							FontSize="14"
							Margin="20,0,0,0"/>
				</Grid>
				<!-- таблица курсов-->
				<Grid>
					<DataGrid x:Name="CoursesGrid"
								ItemsSource="{Binding Courses}"
								AutoGenerateColumns="False"
								CanUserAddRows="False"
								IsReadOnly="True"
								HeadersVisibility="Column"
								BorderThickness="1"
								BorderBrush="LightGray">
						<DataGrid.Columns>
							<!-- столбец Название-->
							<DataGridTextColumn Header="Название"
								Binding="{Binding CourseTitle}"
								Width="250"/>
							<!-- столбец Описание-->
							<DataGridTextColumn Header="Описание"
								Binding="{Binding CourseDescription}"
								Width="300"/>
							<!-- столбец Дата создания-->
							<DataGridTextColumn Header="Дата создания"
								Binding="{Binding CreationDate, StringFormat='dd.MM.yyyy'}"
								Width="100"/>
							<!-- столбец Статус-->
							<DataGridTextColumn Header="Статус"
								Binding="{Binding CourseStatusIdFkNavigation.StatusName}"
								Width="100"/>
							<!-- столбец Ученики-->
							<DataGridTextColumn Header="Ученики"
								Binding="{Binding StudentsCount}"
								Width="100"/>
							<!-- столбец Задания-->
							<DataGridTextColumn Header="Задания"
								Binding="{Binding TasksCount}"
								Width="100"/>
							<!-- столбец действий-->
							<DataGridTemplateColumn Header="Действия" Width="180">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<!-- кнопка открытия деталей-->
											<Button Content="Открыть"
													Command="{Binding DataContext.OpenCourseDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
													CommandParameter="{Binding}"
													Margin="2"
													Padding="8,4"
													Background="#34A853"
													Foreground="White"
													FontSize="12"/>
											<!-- кнопка архивации-->
											<Button Content="Завершить"
													Command="{Binding DataContext.ArchiveCourseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
													CommandParameter="{Binding}"
													Margin="2"
													Padding="8,4"
													Background="#4285F4"
													Foreground="White"
													FontSize="12"/>
										</StackPanel>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</StackPanel>
			<!-- ДЕТАЛИ КУРСА-->
			<Grid Grid.Column="1" Grid.ColumnSpan="2"
					Visibility="{Binding ShowCourseDetailsVisibility}"
					Background="White"
					Panel.ZIndex="500"
					Margin="20">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<!-- заголовок и кнопка назад-->
					<Grid Grid.Row="0" Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<!-- кнопка назад-->
						<Button Grid.Column="0"
								Content="← Назад к курсам"
								Command="{Binding BackToCoursesCommand}"
								Width="150" Height="35"
								Background="White"
								BorderBrush="LightGray"
								FontWeight="SemiBold"
								Margin="0,0,20,0"/>
						<!-- название курса-->
						<TextBlock Grid.Column="1"
								Text="{Binding CurrentCourseDetails.CourseTitle}"
								FontSize="28"
								FontWeight="Bold"
								VerticalAlignment="Center"/>
						<!-- статус курса-->
						<Border Grid.Column="2"
								Background="{Binding CurrentCourseDetails.CourseStatusIdFkNavigation.StatusName,
								Converter={StaticResource StatusToColorConverter}}"
								CornerRadius="5"
								Padding="15,8"
								VerticalAlignment="Center">
							<TextBlock Text="{Binding CurrentCourseDetails.CourseStatusIdFkNavigation.StatusName}"
									Foreground="White"
									FontWeight="Bold"/>
						</Border>
					</Grid>
					<!-- информация о курсе-->
					<Border Grid.Row="1"
							BorderBrush="LightGray"
							BorderThickness="0,0,0,1"
							Margin="0,0,0,20"
							Padding="0,0,0,20">
						<StackPanel>
							<!-- описание курса-->
							<TextBlock Text="{Binding CurrentCourseDetails.CourseDescription}"
									FontSize="14"
									TextWrapping="Wrap"
									Margin="0,0,0,15"/>
							<!-- статистика курса-->
							<WrapPanel>
								<!-- ментор-->
								<Border BorderBrush="LightGray"
										BorderThickness="1"
										CornerRadius="5"
										Padding="15,10"
										Margin="0,0,15,5">
									<StackPanel>
										<TextBlock Text="Ментор"
												FontSize="11"
												Foreground="Gray"
												Margin="0,0,0,2"/>
										<TextBlock Text="{Binding CurrentCourseDetails.MentorIdFkNavigation.FullName}"
											FontWeight="SemiBold"/>
									</StackPanel>
								</Border>
								<!-- дата создания-->
								<Border BorderBrush="LightGray"
										BorderThickness="1"
										CornerRadius="5"
										Padding="15,10"
										Margin="0,0,15,5">
									<StackPanel>
										<TextBlock Text="Дата создания"
											FontSize="11"
											Foreground="Gray"
											Margin="0,0,0,2"/>
										<TextBlock Text="{Binding CurrentCourseDetails.CreationDate, StringFormat='dd.MM.yyyy'}"
											FontWeight="SemiBold"/>
									</StackPanel>
								</Border>
								<!-- ученики-->
								<Border BorderBrush="LightGray"
										BorderThickness="1"
										CornerRadius="5"
										Padding="15,10"
										Margin="0,0,15,5">
									<StackPanel>
										<TextBlock Text="Учеников"
											FontSize="11"
											Foreground="Gray"
											Margin="0,0,0,2"/>
										<TextBlock Text="{Binding CurrentCourseDetails.StudentsCount}"
											FontSize="16"
											FontWeight="Bold"/>
									</StackPanel>
								</Border>
								<!-- задания-->
								<Border BorderBrush="LightGray"
										BorderThickness="1"
										CornerRadius="5"
										Padding="15,10"
										Margin="0,0,15,5">
									<StackPanel>
										<TextBlock Text="Заданий"
											FontSize="11"
											Foreground="Gray"
											Margin="0,0,0,2"/>
										<TextBlock Text="{Binding CurrentCourseDetails.TasksCount}"
											FontSize="16"
											FontWeight="Bold"/>
									</StackPanel>
								</Border>
							</WrapPanel>
						</StackPanel>
					</Border>
					<!-- табы-->
					<TabControl Grid.Row="2">
						<!-- таб Ученики-->
						<TabItem Header="Ученики">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="*"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<!-- список учеников-->
								<DataGrid Grid.Row="0"
											ItemsSource="{Binding CourseStudents}"
											AutoGenerateColumns="False"
											CanUserAddRows="False"
											IsReadOnly="True">
									<DataGrid.Columns>
										<!-- столбец Логин-->
										<DataGridTextColumn Header="Логин"
											Binding="{Binding Username}"
											Width="120"/>
										<!-- столбец ФИО-->
										<DataGridTextColumn Header="ФИО"
											Binding="{Binding FullName}"
											Width="200"/>
										<!-- столбец действий-->
										<DataGridTemplateColumn Header="Действия" Width="100">
											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate>
													<Button Content="Профиль"
														Command="{Binding DataContext.OpenStudentProfileCommand,
														RelativeSource={RelativeSource AncestorType=Window}}"
														CommandParameter="{Binding}"
														Background="#4285F4"
														Foreground="White"
														Padding="10,3"/>
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>
									</DataGrid.Columns>
								</DataGrid>
								<!-- кнопка добавления учеников-->
								<StackPanel Grid.Row="1"
											Orientation="Horizontal"
											HorizontalAlignment="Right"
											Margin="0,10,0,0">
									<Button Content="Добавить учеников"
											Command="{Binding OpenSelectStudentsModalCommand}"
											Width="150" Height="35"
											Background="#4285F4"
											Foreground="White"
											FontWeight="Bold"/>
								</StackPanel>
							</Grid>
						</TabItem>
						<!-- таб Задания-->
						<TabItem Header="Задания">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="*"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<!-- список заданий-->
								<DataGrid Grid.Row="0"
											ItemsSource="{Binding CourseTasks}"
											AutoGenerateColumns="False"
											CanUserAddRows="False"
											IsReadOnly="True">
									<DataGrid.Columns>
										<!-- столбец Название-->
										<DataGridTextColumn Header="Название"
											Binding="{Binding TaskTitle}"
											Width="200"/>
										<!-- столбец Описание-->
										<DataGridTextColumn Header="Описание"
											Binding="{Binding TaskDescription}"
											Width="300"/>
										<!-- столбец Срок сдачи-->
										<DataGridTextColumn Header="Срок сдачи"
											Binding="{Binding DueDate, StringFormat='dd.MM.yyyy'}"
											Width="120"/>
										<!-- столбец Дата создания-->
										<DataGridTextColumn Header="Дата создания"
											Binding="{Binding CreatedDate, StringFormat='dd.MM.yyyy'}"
											Width="120"/>
									</DataGrid.Columns>
								</DataGrid>
								<!-- кнопка добавления задания-->
								<StackPanel Grid.Row="1"
											Orientation="Horizontal"
											HorizontalAlignment="Right"
											Margin="0,10,0,0">
									<Button Content="Добавить задание"
											Command="{Binding AddTaskToCourseCommand}"
											Width="150" Height="35"
											Background="#34A853"
											Foreground="White"
											FontWeight="Bold"/>
								</StackPanel>
							</Grid>
						</TabItem>
					</TabControl>
				</Grid>
			</Grid>
			<!-- МОДАЛКА ДОБАВЛЕНИЯ НОВОГО ПОЛЬЗОВАТЕЛЯ-->
			<Grid Grid.ColumnSpan="2"
					Visibility="{Binding ShowAddUserModalVisibility}"
					Panel.ZIndex="1000"
					Background="#80000000">
				<Border Width="400"
						Height="400"
						Background="White"
						CornerRadius="10"
						BorderBrush="LightGray"
						BorderThickness="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
					<Grid Margin="20">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<!-- заголовок модалки-->
						<TextBlock Grid.Row="0"
								Text="Добавить нового пользователя"
								FontSize="18"
								FontWeight="Bold"
								Margin="0,0,0,20"/>
						<!-- поля формы-->
						<StackPanel Grid.Row="1" Orientation="Vertical">
							<!-- поле Username-->
							<StackPanel>
								<TextBlock Text="Логин:" FontWeight="SemiBold"/>
								<TextBox x:Name="UsernameTextBox"
										Height="28"
										Padding="5"
										Text="{Binding NewUser.Username, UpdateSourceTrigger=PropertyChanged}"/>
							</StackPanel>
							<!-- поле Password-->
							<StackPanel>
								<TextBlock Text="Пароль:" FontWeight="SemiBold"/>
								<TextBox x:Name="PasswordTextBox"
									Height="28"
									Padding="5"
									Text="{Binding NewUser.Password, UpdateSourceTrigger=PropertyChanged}"/>
							</StackPanel>
							<!-- поле ФИО-->
							<StackPanel>
								<TextBlock Text="ФИО:" FontWeight="SemiBold"/>
								<TextBox x:Name="FullNameTextBox"
									Height="28"
									Padding="5"
									Text="{Binding NewUser.FullName, UpdateSourceTrigger=PropertyChanged}"/>
							</StackPanel>
							<!-- поле Описание-->
							<StackPanel>
								<TextBlock Text="Описание:" FontWeight="SemiBold"/>
								<TextBox Height="28"
									Padding="5"
									Text="{Binding NewUser.AccountDescription, UpdateSourceTrigger=PropertyChanged}"/>
							</StackPanel>
							<!-- выбор роли-->
							<StackPanel>
								<TextBlock Text="Роль:" FontWeight="SemiBold"/>
								<ComboBox x:Name="RoleComboBox"
										Height="28"
										DisplayMemberPath="RoleName"
										SelectedValuePath="RoleId"
										SelectedValue="{Binding NewUser.RoleIdFk}"
										ItemsSource="{Binding AvailableRoles}"/>
							</StackPanel>
						</StackPanel>
						<!-- кнопки-->
						<StackPanel Grid.Row="2"
									Orientation="Horizontal"
									HorizontalAlignment="Right"
									Margin="0,20,0,0">
							<!-- кнопка отмены-->
							<Button Content="Отменить"
									Width="173"
									Height="30"
									Command="{Binding CancelAddUserCommand}"
									Margin="0,0,10,0"/>
							<!-- кнопка добавления-->
							<Button Content="Добавить"
									Width="175"
									Height="30"
									Command="{Binding ConfirmAddUserCommand}"
									Background="#6EB570"
									FontWeight="Bold"/>
						</StackPanel>
					</Grid>
				</Border>
			</Grid>
			<!-- МОДАЛКА РЕДАКТИРОВАНИЯ ПОЛЬЗОВАТЕЛЯ-->
			<Grid Grid.ColumnSpan="2"
				Visibility="{Binding ShowEditUserModalVisibility}"
				Panel.ZIndex="1001"
				Background="#80000000">
				<Border Width="400"
						Height="400"
						Background="White"
						CornerRadius="10"
						BorderBrush="LightGray"
						BorderThickness="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
					<Grid Margin="20">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<!-- заголовок модалки-->
						<TextBlock Grid.Row="0"
							Text="Редактировать пользователя"
							FontSize="18"
							FontWeight="Bold"
							Margin="0,0,0,20"/>
						<!-- поля формы-->
						<StackPanel Grid.Row="1" Orientation="Vertical">
							<!-- поле Username-->
							<StackPanel>
								<TextBlock Text="Логин:" FontWeight="SemiBold"/>
								<TextBox Height="28"
									Padding="5"
									Text="{Binding SelectedUser.Username, UpdateSourceTrigger=PropertyChanged}"/>
							</StackPanel>
							<!-- поле Password-->
							<StackPanel>
								<TextBlock Text="Пароль:" FontWeight="SemiBold"/>
								<TextBox Height="28"
									Padding="5"
									Text="{Binding SelectedUser.Password, UpdateSourceTrigger=PropertyChanged}"/>
							</StackPanel>
							<!-- поле ФИО-->
							<StackPanel>
								<TextBlock Text="ФИО:" FontWeight="SemiBold"/>
								<TextBox Height="28"
									Padding="5"
									Text="{Binding SelectedUser.FullName, UpdateSourceTrigger=PropertyChanged}"/>
							</StackPanel>
							<!-- поле Описание-->
							<StackPanel>
								<TextBlock Text="Описание:" FontWeight="SemiBold"/>
								<TextBox Height="28"
									Padding="5"
									Text="{Binding SelectedUser.AccountDescription, UpdateSourceTrigger=PropertyChanged}"/>
							</StackPanel>
							<!-- выбор роли-->
							<StackPanel>
								<TextBlock Text="Роль:" FontWeight="SemiBold"/>
								<ComboBox Height="28"
										DisplayMemberPath="RoleName"
										SelectedValuePath="RoleId"
										SelectedValue="{Binding SelectedUser.RoleIdFk}"
										ItemsSource="{Binding AvailableRoles}"/>
							</StackPanel>
							<!-- выбор статуса-->
							<StackPanel>
								<TextBlock Text="Статус:" FontWeight="SemiBold"/>
								<ComboBox Height="28"
										DisplayMemberPath="StatusName"
										SelectedValuePath="AccountStatusId"
										SelectedValue="{Binding SelectedUser.AccountStatusFk}"
										ItemsSource="{Binding AvailableStatuses}"/>
							</StackPanel>
						</StackPanel>
						<!-- кнопки-->
						<StackPanel Grid.Row="2"
									Orientation="Horizontal"
									HorizontalAlignment="Right"
									Margin="0,20,0,0">
							<!-- кнопка отмены-->
							<Button Content="Отменить"
									Width="173"
									Height="30"
									Command="{Binding CancelEditCommand}"
									Margin="0,0,10,0"/>
							<!-- кнопка сохранения-->
							<Button Content="Сохранить"
									Width="175"
									Height="30"
									Command="{Binding SaveEditCommand}"
									Background="#6EB570"
									Foreground="White"
									FontWeight="Bold"/>
						</StackPanel>
					</Grid>
				</Border>
			</Grid>
			<!-- МОДАЛКА ДОБАВЛЕНИЯ НОВОГО КУРСА-->
			<Grid Grid.ColumnSpan="2"
				Visibility="{Binding ShowAddCourseModalVisibility}"
				Panel.ZIndex="1000"
				Background="#80000000">
				<Border Width="400"
						Height="320"
						Background="White"
						CornerRadius="10"
						BorderBrush="LightGray"
						BorderThickness="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
					<Grid Margin="20">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<!-- заголовок модалки-->
						<TextBlock Grid.Row="0"
								Text="Добавить новый курс"
								FontSize="18"
								FontWeight="Bold"
								Margin="0,0,0,20"/>
						<!-- поля формы-->
						<StackPanel Grid.Row="1" Orientation="Vertical">
							<!-- поле названия курса-->
							<StackPanel>
								<TextBlock Text="Название курса:" FontWeight="SemiBold"/>
								<TextBox x:Name="CourseTitleTextBox"
									Height="28"
									Padding="5"
									Text="{Binding NewCourse.CourseTitle, UpdateSourceTrigger=PropertyChanged}"/>
							</StackPanel>
							<!-- поле описания-->
							<StackPanel>
								<TextBlock Text="Описание:" FontWeight="SemiBold"/>
								<TextBox x:Name="CourseDescriptionTextBox"
									Height="28"
									Padding="5"
									Text="{Binding NewCourse.CourseDescription, UpdateSourceTrigger=PropertyChanged}"/>
							</StackPanel>
							<!-- выбор учеников-->
							<StackPanel Margin="0,0,0,10">
								<TextBlock Text="Ученики:" FontWeight="SemiBold"/>
								<!-- кнопка выбора учеников-->
								<Button Content="Выбрать учеников"
										Command="{Binding OpenSelectStudentsModalCommand}"
										Height="32"
										Background="#E8F4FD"
										BorderBrush="#4285F4"
										BorderThickness="1"
										Foreground="#4285F4"
										FontWeight="SemiBold"
										Margin="0,5,0,0"/>
								<!-- счетчик выбранных учеников-->
								<TextBlock Text="{Binding SelectedStudentsCountText}"
										FontSize="12"
										Foreground="Gray"
										Margin="0,8,0,5"/>
								<!-- список выбранных учеников-->
								<ItemsControl ItemsSource="{Binding SelectedStudents}"
											Margin="0,5,0,0"
											MaxHeight="120"
											ScrollViewer.VerticalScrollBarVisibility="Auto">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border BorderBrush="#E0E0E0"
												BorderThickness="0,0,0,1"
												Padding="5,8">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>
													<!-- информация об ученике-->
													<StackPanel Grid.Column="0">
														<TextBlock Text="{Binding Username}"
															FontWeight="SemiBold"
															FontSize="13"/>
														<TextBlock Text="{Binding FullName}"
															FontSize="11"
															Foreground="Gray"/>
													</StackPanel>
													<!-- кнопка удаления ученика-->
													<Button Grid.Column="1"
														Content="Удалить"
														Command="{Binding DataContext.RemoveStudentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
														CommandParameter="{Binding}"
														Width="24" Height="24"
														Background="Transparent"
														BorderThickness="0"
														FontSize="12"
														Foreground="#AC4242"
														FontWeight="Bold"
														HorizontalAlignment="Right"
														VerticalAlignment="Center"/>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</StackPanel>
						<!-- кнопки-->
						<StackPanel Grid.Row="2"
									Orientation="Horizontal"
									HorizontalAlignment="Right"
									Margin="0,20,0,0">
							<!-- кнопка отмены-->
							<Button Content="Отменить"
									Width="173"
									Height="30"
									Command="{Binding CancelAddCourseCommand}"
									Margin="0,0,10,0"/>
							<!-- кнопка добавления-->
							<Button Content="Добавить"
									Width="175"
									Height="30"
									Command="{Binding ConfirmAddCourseCommand}"
									Background="#6EB570"
									FontWeight="Bold"/>
						</StackPanel>
					</Grid>
				</Border>
			</Grid>
			<!-- МОДАЛКА ВЫБОРА УЧЕНИКОВ-->
			<Grid Grid.ColumnSpan="2"
				Visibility="{Binding ShowSelectStudentsModalVisibility}"
				Panel.ZIndex="1003"
				Background="#80000000">
				<Border Width="550"
						Height="450"
						Background="White"
						CornerRadius="10"
						BorderBrush="LightGray"
						BorderThickness="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
					<Grid Margin="20">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<!-- заголовок и счетчик-->
						<Grid Grid.Row="0" Margin="0,0,0,15">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<!-- заголовок-->
							<TextBlock Grid.Column="0"
								Text="Выберите учеников для курса"
								FontSize="18"
								FontWeight="Bold"/>
							<!-- счетчик выбранных-->
							<TextBlock Grid.Column="1"
								Text="{Binding SelectedStudentsCountText}"
								FontSize="12"
								Foreground="Gray"
								VerticalAlignment="Center"/>
						</Grid>
						<!-- список учеников с чекбоксами-->
						<ListBox Grid.Row="1"
								x:Name="StudentsListBox"
								ItemsSource="{Binding TempSelectedStudents}"
								SelectionMode="Extended"
								Margin="0,0,0,20">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
										Margin="5,3">
										<StackPanel Orientation="Vertical">
											<TextBlock Text="{Binding Account.Username}"
												FontWeight="SemiBold"/>
											<TextBlock Text="{Binding Account.FullName}"
												FontSize="11"
												Foreground="Gray"/>
										</StackPanel>
									</CheckBox>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						<!-- кнопки-->
						<StackPanel Grid.Row="2"
							Orientation="Horizontal"
							HorizontalAlignment="Right">
							<!-- кнопка отмены-->
							<Button Content="Отменить"
								Width="150"
								Height="35"
								Command="{Binding CancelSelectStudentsCommand}"
								Margin="0,0,10,0"/>
							<!-- кнопка сохранения-->
							<Button Content="Сохранить выбор"
								Width="150"
								Height="35"
								Command="{Binding ConfirmSelectStudentsCommand}"
								Background="#4285F4"
								Foreground="White"
								FontWeight="Bold"/>
						</StackPanel>
					</Grid>
				</Border>
			</Grid>
			<!-- МОДАЛКА ПОДТВЕРЖДЕНИЯ АРХИВАЦИИ КУРСА-->
			<Grid Grid.ColumnSpan="2"
				Visibility="{Binding ShowArchiveConfirmationModalVisibility}"
				Panel.ZIndex="1002"
				Background="#80000000">
				<Border Width="400"
						Height="200"
						Background="White"
						CornerRadius="10"
						BorderBrush="LightGray"
						BorderThickness="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
					<Grid Margin="20">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<!-- заголовок-->
						<TextBlock Grid.Row="0"
							Text="Завершить курс"
							FontSize="18"
							FontWeight="Bold"
							Margin="0,0,0,20"/>
						<!-- сообщение подтверждения-->
						<TextBlock Grid.Row="1"
							Text="Вы уверены, что хотите завершить курс? Это действие переведет курс в архив и отключит возможность добавления новых заданий и учеников."
							TextWrapping="Wrap"
							FontSize="14"/>
						<!-- кнопки-->
						<StackPanel Grid.Row="2"
							Orientation="Horizontal"
							HorizontalAlignment="Right"
							Margin="0,20,0,0">
							<!-- кнопка отмены-->
							<Button Content="Отмена"
								Width="120"
								Height="35"
								Command="{Binding CancelArchiveCourseCommand}"
								Margin="0,0,10,0"/>
							<!-- кнопка подтверждения-->
							<Button Content="Завершить"
								Width="120"
								Height="35"
								Command="{Binding ConfirmArchiveCourseCommand}"
								Background="#4285F4"
								Foreground="White"
								FontWeight="Bold"/>
						</StackPanel>
					</Grid>
				</Border>
			</Grid>
			<!-- МОДАЛКА ДОБАВЛЕНИЯ ЗАДАНИЯ-->
			<Grid Grid.ColumnSpan="2"
				Visibility="{Binding ShowAddTaskModalVisibility}"
				Panel.ZIndex="1004"
				Background="#80000000">
				<Border Width="500"
						Height="350"
						Background="White"
						CornerRadius="10"
						BorderBrush="LightGray"
						BorderThickness="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
					<Grid Margin="20">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<!-- заголовок-->
						<TextBlock Grid.Row="0"
							Text="Добавить задание"
							FontSize="18"
							FontWeight="Bold"
							Margin="0,0,0,20"/>
						<!-- поля формы-->
						<StackPanel Grid.Row="1" Orientation="Vertical">
							<!-- название задания-->
							<StackPanel>
								<TextBlock Text="Название задания:" FontWeight="SemiBold"/>
								<TextBox Height="28"
									Padding="5"
									Text="{Binding NewTask.TaskTitle, UpdateSourceTrigger=PropertyChanged}"/>
							</StackPanel>
							<!-- описание задания-->
							<StackPanel>
								<TextBlock Text="Описание:" FontWeight="SemiBold"/>
								<TextBox Height="80"
									Padding="5"
									TextWrapping="Wrap"
									AcceptsReturn="True"
									Text="{Binding NewTask.TaskDescription, UpdateSourceTrigger=PropertyChanged}"/>
							</StackPanel>
							<!-- срок сдачи-->
							<StackPanel>
								<TextBlock Text="Срок сдачи:" FontWeight="SemiBold"/>
								<DatePicker SelectedDate="{Binding NewTask.DueDate, UpdateSourceTrigger=PropertyChanged}"
									Margin="0,5,0,0"/>
							</StackPanel>
						</StackPanel>
						<!-- кнопки-->
						<StackPanel Grid.Row="2"
							Orientation="Horizontal"
							HorizontalAlignment="Right"
							Margin="0,20,0,0">
							<!-- кнопка отмены-->
							<Button Content="Отменить"
								Width="120"
								Height="35"
								Command="{Binding CancelAddTaskCommand}"
								Margin="0,0,10,0"/>
							<!-- кнопка добавления-->
							<Button Content="Добавить"
								Width="120"
								Height="35"
								Command="{Binding ConfirmAddTaskCommand}"
								Background="#34A853"
								Foreground="White"
								FontWeight="Bold"/>
						</StackPanel>
					</Grid>
				</Border>
			</Grid>
			<!-- МОДАЛКА ПРОФИЛЯ СТУДЕНТА-->
			<Grid Grid.ColumnSpan="2"
				Visibility="{Binding ShowStudentProfileModalVisibility}"
				Panel.ZIndex="1005"
				Background="#80000000">
				<Border Width="1000"
						Height="700"
						Background="White"
						CornerRadius="10"
						BorderBrush="LightGray"
						BorderThickness="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
					<Grid Margin="20">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<!-- заголовок профиля-->
						<Grid Grid.Row="0" Margin="0,0,0,20">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<!-- информация о студенте-->
							<StackPanel Grid.Column="0">
								<TextBlock Text="{Binding SelectedStudentProfile.FullName}"
									FontSize="24"
									FontWeight="Bold"/>
								<TextBlock Text="{Binding SelectedStudentProfile.Username}"
									FontSize="14"
									Foreground="Gray"/>
							</StackPanel>
							<!-- кнопка закрытия-->
							<Button Grid.Column="1"
									Content="✕"
									Command="{Binding CloseStudentProfileCommand}"
									Width="30" Height="30"
									Background="Transparent"
									BorderBrush="LightGray"
									FontSize="16"
									FontWeight="Bold"/>
						</Grid>
						<!-- прогресс по заданиям-->
						<DataGrid Grid.Row="1"
								ItemsSource="{Binding StudentTasksInfo}"
								AutoGenerateColumns="False"
								CanUserAddRows="False"
								IsReadOnly="True"
								SelectionMode="Single"
								RowHeight="100">
							<DataGrid.Columns>
								<!-- столбец Задание-->
								<DataGridTextColumn Header="Задание"
									Binding="{Binding Task.TaskTitle}"
									Width="150"/>
								<!-- столбец текстового ответа-->
								<DataGridTemplateColumn Header="Текстовый ответ" Width="250">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<Border BorderThickness="0" Background="White">
												<TextBox Text="{Binding AnswerText, Mode=OneWay}"
														BorderThickness="0"
														Background="Transparent"
														TextWrapping="Wrap"
														IsReadOnly="True"
														MaxHeight="80"
														VerticalScrollBarVisibility="Auto"
														HorizontalScrollBarVisibility="Disabled"
														Padding="5"
														VerticalAlignment="Top"
														AcceptsReturn="True">
													<TextBox.Style>
														<Style TargetType="TextBox">
															<Style.Triggers>
																<DataTrigger Binding="{Binding HasAnswer}" Value="False">
																	<Setter Property="Foreground" Value="Gray"/>
																	<Setter Property="FontStyle" Value="Italic"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</TextBox.Style>
												</TextBox>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
								<!-- столбец Статус-->
								<DataGridTextColumn Header="Статус"
									Binding="{Binding StatusDisplay}"
									Width="100"/>
								<!-- столбец Дата ответа-->
								<DataGridTextColumn Header="Дата ответа"
									Binding="{Binding Answer.AnswerDate, StringFormat='dd.MM.yyyy HH:mm'}"
									Width="120"/>
								<!-- столбец Действия-->
								<DataGridTemplateColumn Header="Действия" Width="220">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
												<!-- кнопка Принять-->
												<Button Content="✓"
														Command="{Binding DataContext.AcceptTaskCommand,
														RelativeSource={RelativeSource AncestorType=Window}}"
														CommandParameter="{Binding Answer}"
														Width="70" Height="30"
														Background="#34A853"
														Foreground="White"
														FontWeight="Bold"
														FontSize="11"
														Margin="2"
														Visibility="{Binding ShowAcceptButton,
														Converter={StaticResource BoolToVisibilityConverter}}"
														ToolTip="Принять задание"/>
												<!-- кнопка Отклонить-->
												<Button Content="✗"
														Command="{Binding DataContext.RejectTaskCommand,
														RelativeSource={RelativeSource AncestorType=Window}}"
														CommandParameter="{Binding Answer}"
														Width="70" Height="30"
														Background="#EA4335"
														Foreground="White"
														FontWeight="Bold"
														FontSize="11"
														Margin="2"
														Visibility="{Binding ShowRejectButton,
														Converter={StaticResource BoolToVisibilityConverter}}"
														ToolTip="Отклонить задание"/>
												<!-- кнопка Отозвать-->
												<Button Content="↻"
														Command="{Binding DataContext.RevokeTaskCommand,
														RelativeSource={RelativeSource AncestorType=Window}}"
														CommandParameter="{Binding Answer}"
														Width="70" Height="30"
														Background="#FBBC05"
														Foreground="White"
														FontWeight="Bold"
														FontSize="11"
														Margin="2"
														Visibility="{Binding ShowRevokeButton,
														Converter={StaticResource BoolToVisibilityConverter}}"
														ToolTip="Вернуть на доработку"/>
											</StackPanel>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
							</DataGrid.Columns>
						</DataGrid>
						<!-- кнопка закрытия-->
						<StackPanel Grid.Row="2"
									Orientation="Horizontal"
									HorizontalAlignment="Right"
									Margin="0,20,0,0">
							<Button Content="Закрыть"
									Command="{Binding CloseStudentProfileCommand}"
									Width="100" Height="35"
									Background="White"
									BorderBrush="LightGray"/>
						</StackPanel>
					</Grid>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</Window>