<Window x:Class="OnbordingPlatform.Views.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--боковое меню-->
        <Border Grid.Column="0" 
               Background="#F5F5F5" 
               BorderBrush="LightGray" 
               BorderThickness="0,0,1,0">
            <StackPanel>
                <Border Height="60" 
                       Background="White" 
                       BorderBrush="LightGray" 
                       BorderThickness="0,0,0,1">
                    <TextBlock Text="Меню" 
                              FontSize="16" 
                              FontWeight="Bold"
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center"/>
                </Border>

                <!--разделы-->
                <StackPanel Margin="10" Orientation="Vertical">
                    <Button Content="Пользователи" 
                            Command="{Binding ShowUsersCommand}"
                            Height="40"
                            Background="{Binding UsersButtonColor}"
                            FontWeight="Bold"
                            Margin="0,10,0,5"/>

                    <Button Content="Курсы" 
                            Command="{Binding ShowCoursesCommand}"
                            Height="40"
                            Background="{Binding CoursesButtonColor}"
                            Margin="0,5,0,0"/>

                    <Button Content="Выйти" 
                            Command="{Binding LogoutCommand}"
                            Height="40"
                            Background="LightCoral"
                            Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--основной контент-->
        <Grid Grid.Column="1">
            <!--пользователи-->
            <StackPanel Visibility="{Binding ShowUsersVisibility}" Margin="20">
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!--логотип-->
                    <Border Grid.Column="0" 
                           Width="40" Height="40" 
                           Background="LightBlue" 
                           CornerRadius="5"
                           Margin="0,0,20,0">
                        <TextBlock Text="GK" 
                                  FontSize="20" 
                                  FontWeight="Bold"
                                  Foreground="White"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                    </Border>

                    <!--название-->
                    <TextBlock Text="Пользователи" 
                              Grid.Column="1"
                              FontSize="28" 
                              FontWeight="Bold"
                              VerticalAlignment="Center"/>

                    <!--профиль-->
                    <Button Grid.Column="2"
                            Content="Профиль"
                            Command="{Binding ProfileCommand}"
                            Width="80" Height="35"
                            Background="White" 
                            BorderBrush="LightGray"
                            FontWeight="Bold"/>
                </Grid>

                <!--счетчик и кнопка добавления-->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!--счетчик-->
                    <Border Grid.Column="0"
                           BorderThickness="1" 
                           BorderBrush="LightGray" 
                           Background="WhiteSmoke" 
                           CornerRadius="5"
                           Padding="20,15">
                        <StackPanel>
                            <TextBlock Text="{Binding UsersCountText}" 
                                      FontSize="18" 
                                      FontWeight="Bold"
                                      Margin="0,0,0,5"/>
                            <TextBlock Text="Количество всех пользователей в системе" 
                                      FontSize="12"
                                      Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <!--кнопка добавления-->
                    <Button Grid.Column="1"
                            Content="Добавить пользователя" 
                            Command="{Binding AddUserCommand}"
                            Width="180" Height="40"
                            Background="#C8FBFF" 
                            FontWeight="Bold"
                            FontSize="14"
                            Margin="20,0,0,0"/>
                    
                </Grid>

                <!--таблица-->
                <Grid>
                    <DataGrid x:Name="UsersGrid"
                                ItemsSource="{Binding Users}"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                IsReadOnly="True"
                                HeadersVisibility="Column"
                                BorderThickness="1"
                                BorderBrush="LightGray">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" 
                                                Binding="{Binding Username}" 
                                                Width="100"/>
                            <DataGridTextColumn Header="Password" 
                                                Binding="{Binding Password}" 
                                                Width="100"/>
                            <DataGridTextColumn Header="ФИО" 
                                                Binding="{Binding FullName}" 
                                                Width="230"/>
                            <DataGridTextColumn Header="Роль" 
                                                Binding="{Binding RoleIdFkNavigation.RoleName}" 
                                                Width="120"/>
                            <DataGridTextColumn Header="Статус" 
                                                Binding="{Binding AccountStatusFkNavigation.StatusName}" 
                                                Width="100"/>
                            <DataGridTextColumn Header="Дата создания" 
                                                Binding="{Binding HireDate, StringFormat='dd.MM.yyyy'}" 
                                                Width="120"/>

                            <!--действия-->
                            <DataGridTemplateColumn Header="Действия" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!--редактирование-->
                                            <Button Content="Редактировать" 
                                                Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="2" 
                                                Padding="8,4"
                                                Background="#4285F4"
                                                Foreground="White"
                                                FontSize="12"/>

                                            <!--удаление-->
                                            <Button Content="Удалить" 
                                                Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="2" 
                                                Padding="8,4"
                                                Background="#AC4242"
                                                Foreground="White"
                                                FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns> 
                    </DataGrid>
                </Grid>
            </StackPanel>

            <!--курсы-->
            <StackPanel Visibility="{Binding ShowCoursesVisibility}">
                <TextBlock Text="Курсы" 
                          FontSize="20" 
                          FontWeight="Bold"
                          Margin="20"/>

                <Button Content="Создать курс" 
                        Width="150" 
                        Height="30"
                        Margin="20,0"/>

                <DataGrid Margin="20" Height="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Width="200"/>
                        <DataGridTextColumn Header="" Width="150"/>
                        <DataGridTextColumn Header="Описание" Width="150"/>
                        <DataGridTextColumn Header="Статус курса" Width="100"/>
                        <DataGridTextColumn Header="Ученики" Width="100"/>
                        <DataGridTextColumn Header="Задания" Width="100"/>
                        <DataGridTextColumn Header="Действия" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
           
        <!--модалка добавления нового пользователя-->
        <Grid Grid.ColumnSpan="2"
              Visibility="{Binding ShowAddUserModalVisibility}"
              Panel.ZIndex="1000"
              Background="#80000000">

            <Border Width="400" 
            Height="320" 
            Background="White" 
            CornerRadius="10"
            BorderBrush="LightGray"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!--заголовок -->
                    <TextBlock Grid.Row="0" 
                       Text="Добавить нового пользователя" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

                    <!--поля формы -->
                    <StackPanel Grid.Row="1" Orientation="Vertical">
                        <!--Username -->
                        <StackPanel>
                            <TextBlock Text="Логин:" FontWeight="SemiBold"/>
                            <TextBox x:Name="UsernameTextBox" 
                                 Height="28" 
                                 Padding="5"
                                 Text="{Binding NewUser.Username, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!--пароль -->
                        <StackPanel>
                            <TextBlock Text="Пароль:" FontWeight="SemiBold"/>
                            <TextBox x:Name="PasswordTextBox" 
                                Height="28" 
                                Padding="5"
                                Text="{Binding NewUser.Password, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!--ФИО -->
                        <StackPanel>
                            <TextBlock Text="ФИО:" FontWeight="SemiBold"/>
                            <TextBox x:Name="FullNameTextBox" 
                                 Height="28" 
                                 Padding="5"
                                 Text="{Binding NewUser.FullName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!--роль -->
                        <StackPanel>
                            <TextBlock Text="Роль:" FontWeight="SemiBold"/>
                            <ComboBox x:Name="RoleComboBox" 
                                 Height="28"
                                 DisplayMemberPath="RoleName"
                                 SelectedValuePath="RoleId"
                                 SelectedValue="{Binding NewUser.RoleIdFk}"
                                 ItemsSource="{Binding AvailableRoles}"/>
                        </StackPanel>
                    </StackPanel>

                    <!--кнопки -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                            <Button Content="Отменить" 
                                Width="173" 
                                Height="30"
                                Command="{Binding CancelAddUserCommand}"
                                Margin="0,0,10,0"/>
                            <Button Content="Добавить" 
                                Width="175" 
                                Height="30"
                                Command="{Binding ConfirmAddUserCommand}"
                                Background="#6EB570"
                                FontWeight="Bold"/> 
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!--модалка редактирования-->
        <Grid Grid.ColumnSpan="2"
              Visibility="{Binding ShowEditUserModalVisibility}"
              Panel.ZIndex="1001"
              Background="#80000000">

            <Border Width="400" 
                Height="360" 
                Background="White" 
                CornerRadius="10"
                BorderBrush="LightGray"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!--заголовок -->
                    <TextBlock Grid.Row="0"
                               Text="Редактировать пользователя" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>  

                    <StackPanel Grid.Row="1" Orientation="Vertical">
                        <!--username -->
                        <StackPanel>
                            <TextBlock Text="Логин:" FontWeight="SemiBold"/>
                            <TextBox Height="28" 
                                     Padding="5"
                                     Text="{Binding SelectedUser.Username, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!--пароль-->
                        <StackPanel>
                            <TextBlock Text="Пароль:" FontWeight="SemiBold"/>
                            <TextBox Height="28" 
                                     Padding="5"
                                     Text="{Binding SelectedUser.Password, UpdateSourceTrigger=PropertyChanged}"/>  
                        </StackPanel>

                        <!--ФИО-->
                        <StackPanel>
                            <TextBlock Text="ФИО:" FontWeight="SemiBold"/>
                            <TextBox Height="28" 
                                     Padding="5"
                                     Text="{Binding SelectedUser.FullName, UpdateSourceTrigger=PropertyChanged}"/>  
                        </StackPanel>

                        <!--роль-->
                        <StackPanel>
                            <TextBlock Text="Роль:" FontWeight="SemiBold"/>
                            <ComboBox Height="28"
                                      DisplayMemberPath="RoleName"
                                      SelectedValuePath="RoleId"
                                      SelectedValue="{Binding SelectedUser.RoleIdFk}"
                                      ItemsSource="{Binding AvailableRoles}"/>
                        </StackPanel>

                        <!--статус-->
                        <StackPanel>
                            <TextBlock Text="Статус:" FontWeight="SemiBold"/>
                            <ComboBox Height="28"
                                      DisplayMemberPath="StatusName"
                                      SelectedValuePath="AccountStatusId"
                                      SelectedValue="{Binding SelectedUser.AccountStatusFk}"
                                      ItemsSource="{Binding AvailableStatuses}"/>
                        </StackPanel>
                    </StackPanel>

                    <!--кнопки-->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                    <Button Content="Отменить" 
                                Width="173" 
                                Height="30"
                                Command="{Binding CancelEditCommand}"
                                Margin="0,0,10,0"/>
                    <Button Content="Сохранить" 
                                Width="175" 
                                Height="30"
                                Command="{Binding SaveEditCommand}"
                                Background="#6EB570"
                                Foreground="White"
                                FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>



    </Grid>
</Window>