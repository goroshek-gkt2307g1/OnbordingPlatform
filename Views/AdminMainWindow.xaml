<Window x:Class="OnbordingPlatform.Views.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--боковое меню-->
        <Border Grid.Column="0" 
               Background="#F5F5F5" 
               BorderBrush="LightGray" 
               BorderThickness="0,0,1,0">
            <StackPanel>
                <Border Height="60" 
                       Background="White" 
                       BorderBrush="LightGray" 
                       BorderThickness="0,0,0,1">
                    <TextBlock Text="Меню" 
                              FontSize="16" 
                              FontWeight="Bold"
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center"/>
                </Border>

                <!--разделы-->
                <StackPanel Margin="10" Orientation="Vertical">
                    <Button Content="Пользователи" 
                            Command="{Binding ShowUsersCommand}"
                            Height="40"
                            Background="{Binding UsersButtonColor}"
                            FontWeight="Bold"
                            Margin="0,10,0,5"/>

                    <Button Content="Курсы" 
                            Command="{Binding ShowCoursesCommand}"
                            Height="40"
                            Background="{Binding CoursesButtonColor}"
                            Margin="0,5,0,0"/>

                    <Button Content="Выйти" 
                            Command="{Binding LogoutCommand}"
                            Height="40"
                            Background="LightCoral"
                            Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--основной контент-->
        <Grid Grid.Column="1">
            <!--пользователи-->
            <StackPanel Visibility="{Binding ShowUsersVisibility}" Margin="20">
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!--логотип-->
                    <Border Grid.Column="0" 
                           Width="40" Height="40" 
                           Background="LightBlue" 
                           CornerRadius="5"
                           Margin="0,0,20,0">
                        <TextBlock Text="GK" 
                                  FontSize="20" 
                                  FontWeight="Bold"
                                  Foreground="White"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                    </Border>

                    <!--название-->
                    <TextBlock Text="Пользователи" 
                              Grid.Column="1"
                              FontSize="28" 
                              FontWeight="Bold"
                              VerticalAlignment="Center"/>

                    <!--профиль-->
                    <Button Grid.Column="2"
                            Content="Профиль"
                            Command="{Binding ProfileCommand}"
                            Width="80" Height="35"
                            Background="White" 
                            BorderBrush="LightGray"
                            FontWeight="Bold"/>
                </Grid>

                <!--счетчик и кнопка добавления-->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!--счетчик-->
                    <Border Grid.Column="0"
                           BorderThickness="1" 
                           BorderBrush="LightGray" 
                           Background="WhiteSmoke" 
                           CornerRadius="5"
                           Padding="20,15">
                        <StackPanel>
                            <TextBlock Text="{Binding UsersCountText}" 
                                      FontSize="18" 
                                      FontWeight="Bold"
                                      Margin="0,0,0,5"/>
                            <TextBlock Text="Всего пользователей в системе" 
                                      FontSize="12"
                                      Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <!--кнопка добавления-->
                    <Button Grid.Column="1"
                            Content="Добавить пользователя" 
                            Command="{Binding AddUserCommand}"
                            Width="180" Height="40"
                            Background="#C8FBFF" 
                            FontWeight="Bold"
                            FontSize="14"
                            Margin="20,0,0,0"/>
                </Grid>

                <!--таблица-->
                <Grid>
                    <DataGrid x:Name="UsersGrid"
                                ItemsSource="{Binding Users}"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                IsReadOnly="True"
                                HeadersVisibility="Column"
                                BorderThickness="1"
                                BorderBrush="LightGray">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" 
                                                Binding="{Binding Username}" 
                                                Width="150"/>
                            <DataGridTextColumn Header="ФИО" 
                                                Binding="{Binding FullName}" 
                                                Width="200"/>
                            <DataGridTextColumn Header="Роль" 
                                                Binding="{Binding RoleIdFkNavigation.RoleName}" 
                                                Width="120"/>
                            <DataGridTextColumn Header="Статус" 
                                                Binding="{Binding AccountStatusFkNavigation.StatusName}" 
                                                Width="100"/>
                            <DataGridTextColumn Header="Дата создания" 
                                                Binding="{Binding HireDate, StringFormat='dd.MM.yyyy'}" 
                                                Width="120"/>

                            <DataGridTemplateColumn Header="Действия" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Просмотр" 
                                                Command="{Binding DataContext.ViewUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Margin="2" Padding="8,4"
                                                Background="LightBlue"
                                                FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </StackPanel>

            <!--курсы-->
            <!--<StackPanel Visibility="{Binding ShowCoursesVisibility}">
                <TextBlock Text="Курсы" 
                          FontSize="20" 
                          FontWeight="Bold"
                          Margin="20"/>

                <Button Content="Создать курс" 
                        Width="150" 
                        Height="30"
                        Margin="20,0"/>

                <DataGrid Margin="20" Height="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Width="200"/>
                        <DataGridTextColumn Header="Преподаватель" Width="150"/>
                        <DataGridTextColumn Header="Статус" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel> -->
        </Grid>
    </Grid>
</Window>